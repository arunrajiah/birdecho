{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true
    },
    "playstore": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_FDROID": "1"
      },
      "autoIncrement": false
    },
    "appstore": {
      "distribution": "store",
      "autoIncrement": false
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./path/to/google-service-account.json",
        "track": "internal"
      }
    },
    "playstore": {
      "android": {
        "serviceAccountKeyPath": "../wildecho/secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "appstore": {
      "ios": {
        "ascAppId": "6831905164",
        "appleTeamId": "U8MN9X5843",
        "ascApiKeyPath": "../wildecho/secrets/AuthKey_K66G3HL3DK.p8",
        "ascApiKeyIssuerId": "4a98bb81-8056-4d05-acf7-fb3a95fddbee",
        "ascApiKeyId": "K66G3HL3DK"
      }
    }
  }
}
